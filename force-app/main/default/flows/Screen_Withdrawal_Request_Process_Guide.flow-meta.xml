<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <choices>
        <name>Approve_Request</name>
        <choiceText>Approve Request</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Approve Request</stringValue>
        </value>
    </choices>
    <choices>
        <name>Reject_Request</name>
        <choiceText>Reject Request</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Reject Request</stringValue>
        </value>
    </choices>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <name>Rejected_or_Approved</name>
        <label>Rejected or Approved?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Withdrawal_Guide_Screen_2_Approved</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Request Approved</defaultConnectorLabel>
        <rules>
            <name>Request_Rejected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Request_Action_Decision</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Reject_Request</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Withdrawal_Guide_Screen_2_Rejected</targetReference>
            </connector>
            <label>Request Rejected</label>
        </rules>
    </decisions>
    <decisions>
        <name>What_Is_Case_Status_Value</name>
        <label>What Is Case Status Value</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Withdrawal_Requested</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case_Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Withdrawal Requested</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Withdrawal_Guide_Screen_1</targetReference>
            </connector>
            <label>Withdrawal Requested</label>
        </rules>
    </decisions>
    <description>This screen flow will guide case officers through a withdrawal request; capturing information and providing them the ability to approve / reject the request.</description>
    <environments>Default</environments>
    <interviewLabel>Screen - Withdrawal Process Guide {!$Flow.CurrentDateTime}</interviewLabel>
    <isAdditionalPermissionRequiredToRun>true</isAdditionalPermissionRequiredToRun>
    <label>Screen - Withdrawal Request Process Guide</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_Case_Record</name>
        <label>Get Case Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>What_Is_Case_Status_Value</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Case_To_In_Progress</name>
        <label>Update Case To In-Progress</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>In-Progress</stringValue>
            </value>
        </inputAssignments>
        <object>Case__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Case_To_Withdrawn</name>
        <label>Update Case To Withdrawn</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Withdrawn</stringValue>
            </value>
        </inputAssignments>
        <object>Case__c</object>
    </recordUpdates>
    <screens>
        <name>Withdrawal_Guide_Screen_1</name>
        <label>Withdrawal Guide Screen 1</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Rejected_or_Approved</targetReference>
        </connector>
        <fields>
            <name>Withdrawal_Guide_Screen_1_Title</name>
            <fieldText>&lt;h1&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;Withdrawal Request&lt;/span&gt;&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;{!Get_Case_Record.DNO_Name__c} have requested for this application ({!Get_Case_Record.Name}) to be withdrawn.&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>CP_Spacer_0</name>
            <fieldText>&lt;p&gt; &lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Applicant_Reason_For_Withdrawal</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Reason for withdrawal:&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;We&apos;ve decided not to proceed with the proposed plans due to a change in circumstances beyond our control.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>CP_Spacer_1</name>
            <fieldText>&lt;p&gt; &lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Case_Officer_Terms</name>
            <fieldText>&lt;p&gt;To proceed with this request, please choose one of the two options below. If you choose to reject the request, you must provide a reason for the rejection. This reason will also be shared with the DNO.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>CP_Spacer_2</name>
            <fieldText>&lt;p&gt; &lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Request_Action_Decision</name>
            <choiceReferences>Approve_Request</choiceReferences>
            <choiceReferences>Reject_Request</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Approve or Reject Request</fieldText>
            <fieldType>RadioButtons</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Reason_for_Rejection</name>
            <fieldText>Reason for Rejection</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <helpText>&lt;p&gt;What is the reason you have rejected the request for the application to be withdrawn? This will be shared with the DNO.&lt;/p&gt;</helpText>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <validationRule>
                <errorMessage>&lt;p&gt;You must provide a reason for rejection.&lt;/p&gt;</errorMessage>
                <formulaExpression>NOT(ISBLANK({!Reason_for_Rejection}))</formulaExpression>
            </validationRule>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>Request_Action_Decision</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <elementReference>Reject_Request</elementReference>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <nextOrFinishButtonLabel>Next Step</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Withdrawal_Guide_Screen_2_Approved</name>
        <label>Withdrawal Guide Screen 2 - Approved</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <backButtonLabel>Previous Screen</backButtonLabel>
        <connector>
            <targetReference>Update_Case_To_Withdrawn</targetReference>
        </connector>
        <fields>
            <name>Copy_1_of_Copy_1_of_Applicant_Reason_For_Withdrawal</name>
            <fieldText>&lt;h1&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;Withdrawal Request&lt;/span&gt;&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;Are you sure you wish to approve the withdrawal request? Please be aware that once a case is marked as &lt;/span&gt;&lt;em style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;withdrawn&lt;/em&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;, the action is &lt;/span&gt;&lt;strong style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;permanent&lt;/strong&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt; and &lt;/span&gt;&lt;strong style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;cannot be undone&lt;/strong&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;. The case will also be &lt;/span&gt;&lt;strong style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;locked&lt;/strong&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt; and no longer editable from the point of withdrawal.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;To proceed, you must confirm your decision by checking the box below. Once the case has been officially marked as &lt;em style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;withdrawn&lt;/em&gt;, a &lt;strong&gt;confirmation email&lt;/strong&gt; will be automatically sent to the Distribution Network Operator (DNO) at:&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>I_understand_wish_to_continue</name>
            <dataType>Boolean</dataType>
            <fieldText>I understand &amp; wish to continue</fieldText>
            <fieldType>InputField</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <validationRule>
                <errorMessage>&lt;p&gt;You must consent to the above before moving on.&lt;/p&gt;</errorMessage>
                <formulaExpression>{!I_understand_wish_to_continue}</formulaExpression>
            </validationRule>
        </fields>
        <nextOrFinishButtonLabel>Approve Withdrawal</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Withdrawal_Guide_Screen_2_Rejected</name>
        <label>Withdrawal Guide Screen 2 - Rejected</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <backButtonLabel>Previous Screen</backButtonLabel>
        <connector>
            <targetReference>Update_Case_To_In_Progress</targetReference>
        </connector>
        <fields>
            <name>Copy_1_of_Copy_1_of_Copy_1_of_Applicant_Reason_For_Withdrawal</name>
            <fieldText>&lt;h1&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;Withdrawal Request&lt;/span&gt;&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;Are you sure you wish to reject the withdrawal request? If you proceed with this, a &lt;/span&gt;&lt;strong style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;confirmation email&lt;/strong&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255);&quot;&gt; will be automatically sent to the Distribution Network Operator (DNO) with the reason for rejection.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;Reason for rejection:&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;em style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;{!Reason_for_Rejection}&lt;/em&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;To proceed, you must confirm your decision by checking the box below.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Copy_1_of_I_understand_wish_to_continue</name>
            <dataType>Boolean</dataType>
            <fieldText>I understand &amp; wish to continue</fieldText>
            <fieldType>InputField</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <validationRule>
                <errorMessage>&lt;p&gt;You must consent to the above before moving on.&lt;/p&gt;</errorMessage>
                <formulaExpression>{!I_understand_wish_to_continue}</formulaExpression>
            </validationRule>
        </fields>
        <nextOrFinishButtonLabel>Reject Withdrawal</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Case_Record</targetReference>
        </connector>
    </start>
    <status>Draft</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
