    <actionCalls>
        <name>Notify_Case_Officer_That_File_Is_Approved</name>
        <label>Notify Case Officer That File Is Approved</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>customNotificationAction</actionName>
        <actionType>customNotificationAction</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>customNotifTypeId</name>
            <value>
                <elementReference>Get_Consent_Letter_NotificationType.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recipientIds</name>
            <value>
                <elementReference>var_CollectionOfUserIds</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>title</name>
            <value>
                <stringValue>Consent Letter has been approved!</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>body</name>
            <value>
                <elementReference>formula_NotificationBody</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>targetId</name>
            <value>
                <elementReference>triggeringRecord.Case__r.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>customNotificationAction</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Requesting_User_to_CollectionOfUserIds</name>
        <label>Add Requesting User to CollectionOfUserIds</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>var_CollectionOfUserIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>triggeringRecord.Requesting_User__r.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Notify_Case_Officer_That_File_Is_Approved</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Approver_Lookup_Id</name>
        <label>Assign Approver Lookup Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>triggeringRecord.Approver__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_User_From_Approver_Id.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Approver_Lookup</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Has_File_Been_Approved</name>
        <label>Has File Been Approved?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Rejected</defaultConnectorLabel>
        <rules>
            <name>Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_ApproverStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_S37_Consent_Letter_DocumentTemplate</targetReference>
            </connector>
            <label>Approved</label>
        </rules>
    </decisions>
    <description>This subflow handles the next steps once a Document Approval Request has either been approved or rejected</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_NotificationBody</name>
        <dataType>String</dataType>
        <expression>&apos;The Consent Letter for Case &apos; &amp; {!triggeringRecord.Case__r.Name} &amp; &apos; has been approved by &apos; &amp; {!Get_User_From_Approver_Id.Name}</expression>
    </formulas>
    <formulas>
        <name>formula_tokenData</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(
  SUBSTITUTE(
    SUBSTITUTE(
      SUBSTITUTE(
        SUBSTITUTE(
          SUBSTITUTE(
            SUBSTITUTE(
              SUBSTITUTE(
                {!triggeringRecord.Token_Data__c},
                &apos;SUB_User_Title&apos;, &apos;User_Title&apos;
              ),
              &apos;SUB_WITH_APPROVER_TITLE&apos;, {!$User.Title}
            ),
            &apos;SUB_User_Salutation&apos;, &apos;User_Salutation&apos;
          ),
          &apos;SUB_WITH_APPROVER_SALUTATION&apos;, TEXT({!$User.Salutations__c})
        ),
        &apos;SUB_User_First_Name&apos;, &apos;User_First_Name&apos;
      ),
      &apos;SUB_WITH_APPROVER_FIRST_NAME&apos;, {!$User.FirstName}
    ),
    &apos;SUB_User_Last_Name&apos;, &apos;User_Last_Name&apos;
  ),
  &apos;SUB_WITH_APPROVER_LAST_NAME&apos;, {!$User.LastName}
)</expression>
    </formulas>
    <interviewLabel>Subflow - File Approval Process Next Steps {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Subflow - File Approval Process Next Steps</label>
    <processMetadataValues>
        <name>BuilderType</name>
