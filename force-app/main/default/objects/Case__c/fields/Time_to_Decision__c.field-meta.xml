<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Time_to_Decision__c</fullName>
    <externalId>false</externalId>
    <formula>IF(
    AND(
        NOT(ISBLANK(Date_Consent_Sent_to_DNO__c)),
        NOT(ISBLANK(Date_of_Application__c))
    ),
    TEXT(Date_Consent_Sent_to_DNO__c - Date_of_Application__c),
    &quot;N/A&quot;
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Calculates the number of days between the Case Date and the date consent was sent to the DNO.</inlineHelpText>
    <label>Time to Decision</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
