<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>NWL Objector and Land Details</masterLabel>
    <description>Displays the objector, landowner, and related land details for an NWL case.</description>
    <targets>
        <target>lightning__RecordPage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property
                name="recordId"
                type="String"
                label="Case Record ID"
                description="Enter a Case record ID to display its objector and land details."/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>