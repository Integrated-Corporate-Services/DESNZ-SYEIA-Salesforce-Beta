<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DESNZ_Decision_is_Mandatory</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
 NOT(ISBLANK(TEXT(Sub_Status__c))),
 ISBLANK (TEXT(DESNZ_Decision__c))
)</errorConditionFormula>
    <errorDisplayField>DESNZ_Decision__c</errorDisplayField>
    <errorMessage>DESNZ Decision is required.</errorMessage>
</ValidationRule>
