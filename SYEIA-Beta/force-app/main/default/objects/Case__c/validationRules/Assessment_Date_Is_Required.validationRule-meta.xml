<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Assessment_Date_Is_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
NOT($Permission.Bypass_Validation_Rule),
NOT(ISBLANK(PRIORVALUE( Assessment_Date__c ))),
ISBLANK(Assessment_Date__c)
)</errorConditionFormula>
    <errorDisplayField>Assessment_Date__c</errorDisplayField>
    <errorMessage>Assessment Date cannot be blank once Assessment Letter has been sent.</errorMessage>
</ValidationRule>
