<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validate_DNO_Party_Type</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(DNO__c)),
    NOT(ISPICKVAL(DNO__r.Party_Type__c, &quot;DNO&quot;))
)</errorConditionFormula>
    <errorDisplayField>DNO__c</errorDisplayField>
    <errorMessage>The selected party is not a valid DNO. Please choose a party with Party Type set to &quot;DNO&quot;.</errorMessage>
</ValidationRule>
