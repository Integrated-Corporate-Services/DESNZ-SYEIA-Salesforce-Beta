<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Case_PaymentDate_Edit_Check</fullName>
    <active>true</active>
    <description>Payment Date cannot be changed once it has been set.</description>
    <errorConditionFormula>AND(
UPPER(TEXT(Payment__r.Payment_Method__c)) = &quot;BACS&quot;,
ISCHANGED(Payment_Date__c),
NOT(ISBLANK(PRIORVALUE(Payment_Date__c)))
)</errorConditionFormula>
    <errorMessage>Payment Date cannot be changed once it has been set.</errorMessage>
</ValidationRule>
