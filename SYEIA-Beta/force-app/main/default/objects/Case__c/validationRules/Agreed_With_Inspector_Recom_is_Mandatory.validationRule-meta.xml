<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Agreed_With_Inspector_Recom_is_Mandatory</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
NOT(ISBLANK(Inspector_s_Report_Received_Date__c)),
ISBLANK( TEXT(Agreed_With_Inspector_s_Recommendation__c) )
)</errorConditionFormula>
    <errorDisplayField>Agreed_With_Inspector_s_Recommendation__c</errorDisplayField>
    <errorMessage>Agreed With Inspector&apos;s Recommendation is required when Inspector&apos;s Report Received Date is populated.</errorMessage>
</ValidationRule>
