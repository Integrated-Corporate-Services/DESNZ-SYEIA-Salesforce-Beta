<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CTWR_Res_From_Landowner_Date_Is_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
NOT($Permission.Bypass_Validation_Rule),
NOT(ISBLANK(PRIORVALUE( CTWR_Response_From_Landowner_Date__c ))),
ISBLANK(CTWR_Response_From_Landowner_Date__c)
)</errorConditionFormula>
    <errorDisplayField>CTWR_Response_From_Landowner_Date__c</errorDisplayField>
    <errorMessage>CTWR Response From Landowner Date cannot be blank once the CTWR Response From Landowner letter has been sent.</errorMessage>
</ValidationRule>
