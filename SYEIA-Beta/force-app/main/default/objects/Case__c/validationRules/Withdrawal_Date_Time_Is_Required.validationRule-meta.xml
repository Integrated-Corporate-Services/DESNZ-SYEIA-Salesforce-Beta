<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Withdrawal_Date_Time_Is_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(PRIORVALUE(Withdrawal_Date_Time__c))),
    ISBLANK(Withdrawal_Date_Time__c)
)</errorConditionFormula>
    <errorDisplayField>Withdrawal_Date_Time__c</errorDisplayField>
    <errorMessage>Withdrawal Date/Time cannot be blank once the withdrawal letter has been sent.</errorMessage>
</ValidationRule>
