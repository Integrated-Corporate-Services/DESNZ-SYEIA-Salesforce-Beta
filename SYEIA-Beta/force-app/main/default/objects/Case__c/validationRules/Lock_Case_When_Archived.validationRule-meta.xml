<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Lock_Case_When_Archived</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISNEW()),
    ISPICKVAL(PRIORVALUE(Status__c), &quot;Archived&quot;)
)</errorConditionFormula>
    <errorMessage>This case is archived and cannot be modified.</errorMessage>
</ValidationRule>
