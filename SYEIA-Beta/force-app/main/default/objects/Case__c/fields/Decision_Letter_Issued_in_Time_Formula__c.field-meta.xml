<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Decision_Letter_Issued_in_Time_Formula__c</fullName>
    <description>Yes if the Decision Letter date is &lt;= Decision deadline</description>
    <externalId>false</externalId>
    <formula>IF(NOT(OR(ISNULL(Decision_Date__c), ISNULL(Decision_Deadline_Formula__c))),  IF(Decision_Date__c &lt;= Decision_Deadline_Formula__c , &apos;Yes&apos;, &apos;No&apos;), &apos;N/A&apos;)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Yes if the Decision Letter date is &lt;= Decision deadline</inlineHelpText>
    <label>Decision Letter Issued in Time</label>
    <required>false</required>
