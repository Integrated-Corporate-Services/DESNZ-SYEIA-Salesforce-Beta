    <formulas>
        <name>ApplicantConsentstoWrittenRepresentation_ObjectorRequestsOralHearing_Note</name>
        <dataType>String</dataType>
        <expression>&apos;[[Thank you for your correspondence dated [[insert date]], in which you gave your consent to your application being considered by way of the written representation procedure. Please note that we received a response from the objector who did not give their consent and requested an oral hearing.]]&apos;</expression>
    </formulas>
    <formulas>
        <name>ApplicantNoResponse_ObjectorRequestsOralHearing_Note</name>
        <dataType>String</dataType>
        <expression>&apos;[[We refer to our previous letter dated [[CTWR letter date]], in which we sought your consent for your application to be considered by way of the written representation procedure. It is noted that we did not receive a response from you by the deadline.  Please note that we received a response from the objector who did not give their consent and requested an oral hearing.]]&apos;</expression>
    </formulas>
    <formulas>
        <name>ApplicantRequestsOralHearing_ObjectorConsentstoWrittenRepresentation_Note</name>
        <dataType>String</dataType>
        <expression>&apos;[[Thank you for your correspondence dated [[insert date]], in which you requested your application be considered by way of the oral hearing procedure. Please note that we received a response from the objector who gave their consent to the written representation procedure.]]&apos;</expression>
    </formulas>
    <formulas>
        <name>BothRequestOralHearing_Note</name>
        <dataType>String</dataType>
        <expression>&apos;[[Thank you for your correspondence dated [[insert date]], in which you requested your application be considered by way of the oral hearing procedure. Please note that we received a response from the objector who also made the same request.]]&apos;</expression>
    </formulas>
