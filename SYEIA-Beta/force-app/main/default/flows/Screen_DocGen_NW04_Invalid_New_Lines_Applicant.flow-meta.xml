    <formulas>
        <name>formula_CurrentDate</name>
        <dataType>String</dataType>
        <expression>TEXT(
  DAY(TODAY())
) &amp;
CASE(
  MOD(DAY(TODAY()), 10),
  1, IF(DAY(TODAY()) = 11, &quot;th&quot;, &quot;st&quot;),
  2, IF(DAY(TODAY()) = 12, &quot;th&quot;, &quot;nd&quot;),
  3, IF(DAY(TODAY()) = 13, &quot;th&quot;, &quot;rd&quot;),
  &quot;th&quot;
) &amp;
&quot; &quot; &amp;
CASE(
  MONTH(TODAY()),
  1, &quot;January&quot;,
  2, &quot;February&quot;,
  3, &quot;March&quot;,
  4, &quot;April&quot;,
  5, &quot;May&quot;,
  6, &quot;June&quot;,
  7, &quot;July&quot;,
  8, &quot;August&quot;,
  9, &quot;September&quot;,
  10, &quot;October&quot;,
  11, &quot;November&quot;,
  12, &quot;December&quot;,
  &quot;&quot;
) &amp;
&quot; &quot; &amp;
TEXT(YEAR(TODAY()))</expression>
