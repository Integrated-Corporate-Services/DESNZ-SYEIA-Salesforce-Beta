        <fields>
            <name>Confirmation_Message_Header</name>
            <fieldText>&lt;h3&gt;&lt;strong style=&quot;background-color: rgb(255, 255, 255);&quot;&gt;Confirmation Required: Reject Case – DESNZ Reference: {!Get_Case_Using_recordId.Name}&lt;/strong&gt;&lt;/h3&gt;</fieldText>
