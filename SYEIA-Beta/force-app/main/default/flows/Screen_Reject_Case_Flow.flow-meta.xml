            </styleProperties>
        </fields>
        <fields>
            <name>Confirmation_Message_Body</name>
            <fieldText>&lt;p&gt;You are about to reject this case. Please be aware that once a case is marked as &lt;em&gt;rejected&lt;/em&gt;, the action is &lt;strong&gt;permanent&lt;/strong&gt; and &lt;strong&gt;cannot be undone&lt;/strong&gt;. The case will also be &lt;strong&gt;locked&lt;/strong&gt; and no longer editable from the point of rejection.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;To proceed:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Confirm your decision by checking the box below.&lt;/li&gt;&lt;li&gt;Click &lt;strong&gt;Next&lt;/strong&gt; to provide a reason for rejection and to finalise the process.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Once the case has been officially marked as rejected, a &lt;strong&gt;confirmation email&lt;/strong&gt; will be automatically sent to the Distribution Network Operator (DNO) at: &lt;strong&gt;{!Get_Case_Using_recordId.DNO__r.Email__c}&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Important:&lt;/strong&gt; For audit purposes, the case will be automatically stamped with your name and the date/time of rejection upon submission.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>I_understand_wish_to_continue</name>
            <dataType>Boolean</dataType>
            <fieldText>I understand &amp; wish to continue</fieldText>
            <fieldType>InputField</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <validationRule>
                <errorMessage>&lt;p&gt;You must agree to the risks before continuing to the next screen.&lt;/p&gt;</errorMessage>
                <formulaExpression>IF({!I_understand_wish_to_continue}=TRUE,TRUE,FALSE)</formulaExpression>
            </validationRule>
        </fields>
