    <decisions>
        <description>Check if its an NWL Case</description>
        <name>Decision_NWL_Case</name>
        <label>Decision NWL Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_NWL_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varTriggeringCase.Case_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Necessary Wayleaves</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_New_NWL_Case_Alert</targetReference>
            </connector>
            <label>Is NWL Case</label>
        </rules>
        <rules>
            <name>Is_S37_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varTriggeringCase.Case_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Section 37</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_New_S37_Case_Alert</targetReference>
            </connector>
            <label>Is S37 Case</label>
        </rules>
    </decisions>
