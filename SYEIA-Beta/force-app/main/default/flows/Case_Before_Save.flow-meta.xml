    <decisions>
        <name>Check_Type_of_Project</name>
        <label>Check Type of Project</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Is_Case_New_or_Updated</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Selected_No_Value</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Type_of_Project__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Date_of_Application__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Target_Completion_Date_To_Blank</targetReference>
            </connector>
            <label>Selected No Value</label>
        </rules>
        <rules>
            <name>Full_EIA</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Type_of_Project__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Full EIA</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Low_Full_EIA_Target_Completion_Date</targetReference>
            </connector>
            <label>Full_EIA</label>
        </rules>
        <rules>
            <name>No_screening_needed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Type_of_Project__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>No screening needed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>AssignNoScreeningTargetCompletion_Date</targetReference>
            </connector>
            <label>No screening needed</label>
        </rules>
        <rules>
            <name>Screening_Needed_National_Landscapes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Type_of_Project__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Screening needed (National Landscapes)</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Screening_needed_NL_Target_Completion_Date</targetReference>
            </connector>
            <label>Screening Needed (National Landscapes)</label>
        </rules>
        <rules>
            <name>Screening_needed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Type_of_Project__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Screening needed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_SN_Target_Completion_Date</targetReference>
            </connector>
            <label>Screening needed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Case_Status_Updated_To_Complete</name>
        <label>Decision Case Status Updated To Complete</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Is_Status_Changed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Case_Completed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>WasSet</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Case_Actual_Completed_Date_Time</targetReference>
            </connector>
            <label>Case Completed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_DNO_Lookup_Value_Changed</name>
        <label>Has DNO Lookup Value Changed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Is_Type_of_Project_updated</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>DNO_Is_Changed</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.DNO__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.DNO__c</leftValueReference>
                <operator>WasSet</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_DNO_Name</targetReference>
            </connector>
            <label>DNO Is Changed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Case_New_or_Updated</name>
        <label>Is Case New or Updated</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Decision_Case_Status_Updated_To_Complete</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Record Is Updated</defaultConnectorLabel>
        <rules>
            <name>Record_Is_New</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>formula_IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_New_Cases_Queue</targetReference>
            </connector>
            <label>Record Is New</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Status_Changed</name>
        <label>Is Status Changed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>StatusChanged</name>
            <conditionLogic>(1 OR 2) AND 3</conditionLogic>
            <conditions>
                <leftValueReference>formula_IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Withdrawn</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Previous_Status</targetReference>
            </connector>
            <label>Status Changed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Type_of_Project_updated</name>
        <label>Is Type of Project updated</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Is_Case_New_or_Updated</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>(1 AND 2 AND 5) OR 3 OR 4</conditionLogic>
            <conditions>
                <leftValueReference>formula_IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Type_of_Project__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Type_of_Project__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Date_of_Application__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Date_of_Application__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Project_Target_Duration_Dates</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Record_Type_Retrieved</name>
        <label>Record Type Retrieved?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Record_Type</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Found RT</defaultConnectorLabel>
        <rules>
            <name>Failed_To_Find_RT</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Record_Type</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_New_Cases_Queue</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_Status_Changed</targetReference>
            </connector>
            <label>Failed To Find RT</label>
        </rules>
    </decisions>
    <description>SYEIA-77</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>PT_Full_EIA_Target_Completion_Date</name>
        <dataType>Date</dataType>
        <expression>{!$Record.Date_of_Application__c} + {!Get_Project_Target_Duration_Dates.Full_EIA_Duration_Days__c}</expression>
    </formulas>
    <formulas>
        <name>PT_No_screening_Duration_Days</name>
        <dataType>Date</dataType>
        <expression>{!$Record.Date_of_Application__c} + {!Get_Project_Target_Duration_Dates.No_screening_needed_Duration_Days__c}</expression>
    </formulas>
    <formulas>
        <name>PT_Screening_needed_Duration_Days</name>
        <dataType>Date</dataType>
        <expression>{!$Record.Date_of_Application__c} + {!Get_Project_Target_Duration_Dates.Screening_needed_Duration_Days__c}</expression>
    </formulas>
    <formulas>
        <name>PT_Screening_NL_Duration_Days</name>
        <dataType>Date</dataType>
        <expression>{!$Record.Date_of_Application__c} + {!Get_Project_Target_Duration_Dates.Screening_needed_NL_Duration_Days__c}</expression>
    </formulas>
    <formulas>
        <description>Gets the timestamp</description>
        <name>varNow</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
