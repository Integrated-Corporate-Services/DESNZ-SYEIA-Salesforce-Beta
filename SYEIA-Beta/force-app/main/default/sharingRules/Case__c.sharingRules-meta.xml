<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Share_on_Status_To_CO</fullName>
        <accessLevel>Read</accessLevel>
        <description>Share Case Read-only access To Case Officer When status are Withdrawn, Acknowledged, In-Progress, Completed</description>
        <label>Share on Status To CO</label>
        <sharedTo>
            <group>PG_Case_Officer</group>
        </sharedTo>
        <criteriaItems>
            <field>Status__c</field>
            <operation>equals</operation>
            <value>Withdrawn,Acknowledged,In-Progress,Completed</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
